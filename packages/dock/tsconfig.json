{
  "compilerOptions": {
    "strict": true, "noImplicitAny": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "skipLibCheck": true, "module": "esnext",
    "moduleResolution": "bundler", "target": "es2022", "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react-jsx", "allowImportingTsExtensions": true, "esModuleInterop": true, "noEmit": true
  },
  "include": ["src", "tests"],
  "exclude": ["src/client", "tests/client.spec.tsx", "tests/preset-samples.spec.ts", "tests/backend-sync.spec.ts", "tests/mcp-app-tile.spec.ts"]
}
