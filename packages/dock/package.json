{
  "name": "@openloop/dsh-dock",
  "version": "0.9.1",
  "description": "OpenLoop Dock: pin panels and html artifacts to a right-side grid dock powered by react-grid-layout (drag, resize, snap, compaction). Push-out (not floating) layout via margin-right + width calc on #root, sharing the same squeeze channel as dsh-better-sidebar (see docs/DOCK_DESIGN.md §1.1).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && node scripts/verify-client-bundle.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@openloop/dsh-base": "workspace:*",
    "@openloop/dsh-panels": "workspace:*",
    "@openloop/dsh-html-artifact": "workspace:*",
    "@openloop/dsh-mcp": "workspace:*",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "^0.1.1-rc.2",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1",
    "react-grid-layout": "^2.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "external": [
        "@openloop/dsh-base/client",
        "@openloop/dsh-panels/client",
        "@openloop/dsh-html-artifact/client",
        "@openloop/dsh-mcp/client"
      ]
    }
  }
}
