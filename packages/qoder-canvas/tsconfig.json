{
  "compilerOptions": {
    "strict": true, "noImplicitAny": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "skipLibCheck": true, "module": "esnext",
    "moduleResolution": "bundler", "target": "es2022", "lib": ["es2022"],
    "jsx": "react-jsx", "allowImportingTsExtensions": true, "esModuleInterop": true, "noEmit": true
  },
  "include": ["src", "tests"],
  "exclude": ["src/client", "src/app", "src/canvas-app-bridge.ts", "tests/meta-parse.spec.ts", "tests/bridge.spec.ts", "tests/client.spec.tsx"]
}
