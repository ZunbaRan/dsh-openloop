{
  "name": "@openloop/dsh-base",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client.tsx",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./server": {
      "types": "./lib/server/index.d.ts",
      "default": "./lib/server/index.js"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/verify-client-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1",
    "tsdown": "^0.22.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.6",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "description": "OpenLoop base: shared foundation for the OpenLoop DSH plugin family — 61 design tokens (8 OCIX presets x light/dark), settings page host, shared client module, and server-side common services (SSRF-guarded fetch + runtime asset routes).",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
