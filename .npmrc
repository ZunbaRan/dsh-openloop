# pnpm 11's `pnpm run` deps pre-check spawns an install that mis-resolves to the
# home directory project (~ has a package.json with better-sqlite3 etc.) and
# fails with ERR_PNPM_IGNORED_BUILDS. Direct installs are unaffected; disable
# the pre-check for this workspace's script runs.
verify-deps-before-run=false
